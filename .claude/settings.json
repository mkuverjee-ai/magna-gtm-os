{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push origin main --force:*)",
      "Bash(git reset --hard:*)"
    ],
    "allow": [
      "Bash(python3 gtm.py whoami:*)",
      "Bash(python3 gtm.py team:*)",
      "Bash(python3 gtm.py company:*)",
      "Bash(python3 gtm.py keys:*)",
      "Bash(python3 gtm.py campaigns:*)",
      "Bash(python3 gtm.py plays:*)",
      "Bash(python3 gtm.py play:*)",
      "Bash(python3 gtm.py meetings:*)",
      "Bash(python3 gtm.py transcript:*)",
      "Bash(python3 gtm.py intel:*)",
      "Bash(python3 gtm.py doctor:*)",
      "Bash(python3 gtm.py self-update:*)",
      "Bash(python3 gtm.py log-session:*)",
      "Bash(python3 gtm.py log-intel:*)",
      "Bash(python3 files.py check:*)",
      "Bash(python3 files.py add:*)",
      "Bash(python3 import_files.py scan:*)",
      "Bash(python3 skills/google-maps-scraper/gmaps.py whoami:*)",
      "Bash(python3 skills/google-maps-scraper/gmaps.py estimate:*)",
      "Bash(python3 skills/linkedin-scraper/linkedin.py whoami:*)",
      "Bash(python3 skills/meta-ad-counts/meta_ads.py whoami:*)",
      "Bash(bash scripts/update_os.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git pull:*)",
      "Bash(git push origin main:*)",
      "Bash(mdfind:*)",
      "Bash(clay whoami:*)",
      "Bash(clay workspaces list:*)",
      "Bash(clay workflows list:*)",
      "mcp__miro__user_who_am_i",
      "mcp__miro__canvas_get_canvas_composer_skill",
      "mcp__miro__canvas_read_as_svg",
      "mcp__miro__canvas_search",
      "mcp__miro__board_search_boards"
    ]
  },
  "enabledMcpjsonServers": [
    "miro"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "timeout": 10,
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/file_guard.py --post-tool"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 15,
            "command": "python3 \"$CLAUDE_PROJECT_DIR\"/scripts/file_guard.py --stop"
          },
          {
            "type": "command",
            "timeout": 30,
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/autosave.sh --throttle 300"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 90,
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/autosave.sh --final; python3 \"$CLAUDE_PROJECT_DIR\"/gtm.py session-end >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  }
}
